# Copy to $HOME/.config/dce/env and chmod 600. NEVER commit the real file.
#
# User token (works for DMs and every server you are in; technically against
# Discord's ToS to automate — read-only export is lower risk, not zero risk):
#   Browser DevTools -> Network -> any /api/ request -> Authorization header.
#
# Bot token (ToS-clean; cannot read DMs or servers the bot is not in) — use
# `dce --bot -t "$DISCORD_TOKEN" ...` or set DCE_BOT=1 with the wrapper.
DISCORD_TOKEN=PASTE_RAW_USER_TOKEN_HERE

# Optional: set to 1 if the token above is a bot token.
#DCE_BOT=0
